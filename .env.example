NODE_ENV=development
PORT=3000
APP_NAME="Kuroyomi Secure Ebook API"

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root
DB_NAME=manga_ebook_dev

# JWT (Secrets must be at least 32 characters)
JWT_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_REFRESH_EXPIRES_IN=30d

# Mail (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM="Kuroyomi Ebook <your-email@gmail.com>"

# Payment (Set PayPal to Sandbox first; use live credentials and API URL for production)
PAYMENT_PROVIDER=paypal
PAYMENT_RETURN_URL=http://localhost:5173/wallet
PAYMENT_PUBLIC_API_URL=http://localhost:3000
PAYMENT_ORDER_TTL_MINUTES=20
PAYMENT_MAX_PENDING_ORDERS=5
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Discord (create an app/bot and set its Interactions Endpoint URL to
# https://your-api-host/api/payment/discord/interactions)
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_APPLICATION_PUBLIC_KEY=
DISCORD_SERVER_ID=
DISCORD_PAYMENT_CHANNEL_ID=

# Legacy Razorpay configuration (unused by the PayPal provider)
RAZORPAY_KEY=
RAZORPAY_SECRET=

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=ebook-platform-pdfs-prod
MAX_CHAPTER_PDF_SIZE_MB=200

MAX_BOOK_COVER_SIZE_MB=10
