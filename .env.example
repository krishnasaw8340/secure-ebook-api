NODE_ENV=development
PORT=3000
APP_NAME="Kuroyomi Secure Ebook API"

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root
DB_NAME=manga_ebook_dev

# JWT (Secrets must be at least 32 characters)
JWT_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_REFRESH_EXPIRES_IN=30d

# Mail (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM="Kuroyomi Ebook <your-email@gmail.com>"

# Payment (Optional)
RAZORPAY_KEY=
RAZORPAY_SECRET=
